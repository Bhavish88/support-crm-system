# Support CRM System — Environment Configuration Example

# Server Port (default: 8000)
PORT=8000

# Database Connection URL:
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./crm.db

# For production deployment with PostgreSQL (e.g. Railway / Render):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# For standalone frontend deployment (e.g. Vercel / Netlify):
# Set this in your frontend environment pointing to your deployed backend URL:
# VITE_API_URL=https://your-backend-app.onrender.com
